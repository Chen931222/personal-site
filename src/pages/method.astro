---
/**
 * 方法 —— 第二大腦的窗口。
 *
 * 為什麼有這一頁：作品頁證明「他會做網站」，但回答不了「一個大二生怎麼
 * 在一個暑假前後生出這麼多站」。答案是一套工作方式，不是手速。
 *
 * ── 2026-07-30 重做 ─────────────────────────────────────────────────
 * 第一版是五行散文 —— 它在**描述**大腦，而這個文類（digital garden／
 * Obsidian publish／Quartz）的慣例是**展示**大腦。這一版借用文類的三個
 * 正字標記，全部翻成放映室的語彙：
 *
 *   ① 連結圖（Obsidian graph）── 主視覺。點與線都是 vault 實掃的真資料。
 *   ② 檔案樹（explorer）── 窄螢幕的等價呈現，也是圖的無障礙替代。
 *   ③ 筆記卡（frontmatter ＋ [[wiki 連結]]）── 五個支柱不再是列表，
 *      是五篇「打開的筆記」；[[連結]] 是頁內真實可點的錨點，不是裝飾。
 *
 * 沒有做「最近更新 feed」（文類的第四個慣例）：這是靜態站，不會天天重建，
 * 掛一條永遠停在部署日的 feed 等於掛一個壞掉的時鐘。
 *
 * ⚠️ 頁上的數字全部來自 BRAIN（tools/scan-vault.mjs 實掃 G:\Vault 產生），
 *    不再手寫。vault 長了就跑 `npm run sync` 重掃，數字自己對齊 ——
 *    寧可少寫一項，不寫對不上的數。唯一手寫的是 PIPELINES（概念數，不是檔案數）。
 */
import Base from '../layouts/Base.astro';
import BrainGraph from '../components/BrainGraph.astro';
import { SITE } from '../data/site';
import { BRAIN, PIPELINES } from '../data/brain';

/**
 * 五篇方法筆記。links 指向彼此的 anchor —— 文類裡的 [[雙括號連結]]，
 * 在這一頁是真的可以點的（跳到那張卡），不是畫出來的括號。
 */
const NOTES = [
  {
    id: 'md',
    slug: 'plain-files',
    title: '資料夾即應用',
    latin: 'PLAIN FILES',
    desc: `整座腦是一個資料夾裡的純 Markdown，現在是 ${BRAIN.total} 篇。Obsidian 負責看，AI 直接讀寫；哪天哪個工具倒了，檔案都還是我的。`,
    links: [
      { to: 'nav', label: '兩層導航' },
      { to: 'in', label: '六條輸入管線' },
    ],
  },
  {
    id: 'nav',
    slug: 'two-layer-map',
    title: '兩層導航',
    latin: 'TWO-LAYER MAP',
    desc: 'AI 進來先讀一張總地圖，決定要動哪個資料夾，再讀那個資料夾自己的索引。一次只開真正需要的那幾篇，不是每次把整座腦掃一遍。',
    links: [
      { to: 'md', label: '資料夾即應用' },
      { to: 'ctx', label: '先讀我是誰' },
    ],
  },
  {
    id: 'ctx',
    slug: 'context-first',
    title: '先讀我是誰',
    latin: 'CONTEXT FIRST',
    desc: '七份 context 檔寫著我的品味、目標與禁區——做網站有一份、看盤有一份。動工前先讀對的那份，產出才會像我，不是預設值的 AI。',
    links: [
      { to: 'nav', label: '兩層導航' },
      { to: 'log', label: '每日交接' },
    ],
  },
  {
    id: 'in',
    slug: 'intake',
    title: '六條輸入管線',
    latin: 'INTAKE',
    desc: '路上想到的用語音丟進收件匣，網頁用剪藏存全文，紙本書拍照 OCR。捕捉必須零費力——回到電腦，一個指令歸檔。',
    links: [
      { to: 'md', label: '資料夾即應用' },
    ],
  },
  {
    id: 'log',
    slug: 'handoff',
    title: '每日交接',
    latin: 'HANDOFF',
    desc: '每段工作結束，AI 把做了什麼、決定了什麼、卡在哪，寫進當天的日誌。明天的 AI 只讀最近幾天，不必重新認識我一次。',
    links: [
      { to: 'ctx', label: '先讀我是誰' },
      { to: 'nav', label: '兩層導航' },
    ],
  },
];

/** 檔案樹：連結圖的另一種畫法（同一份實掃資料 BRAIN），窄螢幕與螢幕閱讀器用 */
const F = BRAIN.folders;
const TREE = [
  { d: 0, name: 'G:\\Vault', note: '' },
  { d: 1, name: 'CLAUDE.md', note: '總地圖 —— AI 進門先讀' },
  { d: 1, name: `Context/ ${F.context}`, note: '我是誰 —— 做這站前 AI 先讀「網站開發」' },
  { d: 1, name: `1 Projects/ ${F.projects}`, note: '每個站一篇源頭筆記' },
  { d: 1, name: `3 Topics/ ${F.topics}`, note: '手藝：視覺規格、步進展示…' },
  { d: 1, name: `Journal/ ${F.journal}`, note: '每日交接' },
  { d: 1, name: `Clippings/ ${F.clippings}`, note: '剪藏進來的全文' },
  { d: 1, name: `Reading/ ${F.reading}`, note: '紙本書拍照 OCR' },
  { d: 1, name: `0 Inbox/ ${F.inbox}`, note: '語音先丟這裡（空的＝已歸檔）' },
];
---

<Base
  title="方法"
  description="做出這些網站的方法：一座本地的 Markdown 知識庫，加上讀得懂它的 AI。"
>
  <header class="wrap head">
    <p class="mono">[ METHOD ]</p>
    <h1 class="t-display head__h">第二<br /><em class="head__ac">大腦</em></h1>
    <p class="t-lede head__lede">
      站上每一件作品的背後是同一套工作方式：<br />
      一座放在自己硬碟裡的知識庫，加上讀得懂它的 AI。
    </p>

    <div class="head__stats">
      <p class="mono"><span class="dot dot--live" aria-hidden="true" />{BRAIN.total} 篇筆記</p>
      <p class="mono"><span class="dot" aria-hidden="true" />{String(BRAIN.folders.context).padStart(2, '0')} 份 CONTEXT</p>
      <p class="mono"><span class="dot" aria-hidden="true" />{String(PIPELINES).padStart(2, '0')} 條管線</p>
      <p class="mono head__span">{BRAIN.scannedAt} 實掃</p>
    </div>
  </header>

  <!-- ── 連結圖：這座腦長這樣 ─────────────────────────────────────── -->
  <section class="wrap atlas" aria-label="知識庫的連結圖">
    <div class="atlas__head">
      <h2 class="mono mono--bright">[ 這座腦長這樣 ]</h2>
      <p class="mono atlas__legend" aria-hidden="true">
        <span class="atlas__k atlas__k--folder"></span>資料夾
        <span class="atlas__k atlas__k--note"></span>筆記
        <span class="atlas__k atlas__k--hot"></span>做這站先讀的那篇
      </p>
    </div>

    <figure class="atlas__fig">
      <div class="atlas__graph">
        <BrainGraph />
      </div>

      <!-- 同一份真相的文字畫法：窄螢幕取代圖，寬螢幕留給螢幕閱讀器 -->
      <div class="atlas__tree" role="img" aria-label="知識庫的資料夾結構">
        {
          TREE.map((t, i) => (
            <p class="mono atlas__row" data-d={t.d}>
              <span class="atlas__name">
                {i > 0 && <span class="atlas__br" aria-hidden="true">{i === TREE.length - 1 ? '└─' : '├─'}</span>}
                {t.name}
              </span>
              {t.note && <span class="atlas__note">{t.note}</span>}
            </p>
          ))
        }
      </div>

      <!-- 措辭不指涉「圖」或「紅色」：窄螢幕上圖換成了檔案樹，
           指著一個看不見的東西講話，讀起來像壞掉。 -->
      <figcaption class="t-body atlas__cap">
        上面每一個點、每一行，都是硬碟裡真實存在的檔案（{BRAIN.scannedAt} 實掃）。
        「網站開發」那篇寫著我的視覺品味與禁區 ——
        做這個網站之前，AI 先讀的就是它。<strong>這一頁本身，就是這套方法的產出。</strong>
      </figcaption>
    </figure>
  </section>

  <!-- ── 五篇方法筆記 ─────────────────────────────────────────────── -->
  <section class="wrap deck" aria-label="方法筆記">
    <h2 class="mono mono--bright deck__h">[ 打開五篇 ]</h2>

    <ol class="cards">
      {
        NOTES.map((r, i) => (
          <li class="card" id={r.id}>
            <p class="mono mono-sm card__fm" aria-hidden="true">
              ---<br />
              name: {r.slug}<br />
              type: method · {String(i + 1).padStart(2, '0')}<br />
              ---
            </p>
            <h3 class="card__t t-title">
              {r.title}
              <span class="mono card__latin">{r.latin}</span>
            </h3>
            <p class="card__d t-body">{r.desc}</p>
            <p class="mono card__links">
              <span class="card__lk" aria-hidden="true">⟷</span>
              {
                r.links.map((l) => (
                  <a class="card__wiki" href={`#${l.to}`}>
                    <span class="card__br" aria-hidden="true">[[</span>{l.label}<span
                      class="card__br"
                      aria-hidden="true"
                    >]]</span>
                  </a>
                ))
              }
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap tail">
    <!-- 出處寫明白：方法的起點是別人的教學，長成現在這樣是自己用出來的。
         這站的收錄判準（有沒有自己解掉的問題）對這一頁同樣適用。 -->
    <p class="t-body tail__p">
      起點是一支別人的教學影片；兩層導航、先讀我是誰、每日交接，是自己一天一天用出來的。
      這個網站的文案、數字與待補清單，都是從這座腦裡長出來的。
    </p>
    <p class="t-body">
      <a class="lnk" href="/work">看它長出了什麼 →</a>
      <a class="lnk tail__mail" href={`mailto:${SITE.contact.email}`}>或寫信問我 →</a>
    </p>
  </section>
</Base>

<style>
  .head {
    padding-block: var(--s6) var(--s5);
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .head__h {
    margin-top: var(--s2);
  }

  .head__ac {
    font-style: italic;
    color: var(--red);
  }

  .head__lede {
    margin-top: var(--s3);
    color: var(--paper-78);
  }

  .head__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s5);
    margin-top: var(--s3);
  }

  .head__stats p {
    display: flex;
    align-items: center;
    gap: var(--s2);
    min-height: 24px;
  }

  .head__span {
    color: var(--paper-58);
    font-variant-numeric: tabular-nums;
  }

  /* --- 連結圖 -------------------------------------------------------------- */

  .atlas {
    padding-block: var(--s5) var(--s6);
    border-top: 1px solid var(--paper-18);
  }

  .atlas__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s2) var(--s4);
  }

  .atlas__legend {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--paper-58);
  }

  .atlas__k {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
    margin-left: var(--s3);
  }

  .atlas__k--folder { background: var(--paper-78); }
  .atlas__k--note { background: var(--paper-58); }
  .atlas__k--hot { background: var(--red); }

  .atlas__graph {
    margin-top: var(--s4);
    /* 圖自己就是暗房裡的星圖，不加框 —— 1px 規線會把它讀成「圖表」 */
  }

  /* 檔案樹：窄螢幕的等價呈現。寬螢幕收成 sr-only（圖是 aria-hidden 的，
     這份才是輔助技術讀到的內容） */
  .atlas__tree {
    margin-top: var(--s4);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .atlas__row {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    color: var(--paper-78);
    /* 檔案樹是真實路徑，不吃全域 .mono 的大寫 —— G:\Vault 不是 G:\VAULT */
    text-transform: none;
  }

  .atlas__row[data-d='1'] {
    padding-left: var(--s2);
  }

  .atlas__br {
    color: var(--paper-58);
    margin-right: 6px;
  }

  .atlas__name {
    white-space: nowrap;
  }

  .atlas__note {
    color: var(--paper-58);
    min-width: 0;
  }

  @media (min-width: 768px) {
    .atlas__tree {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .atlas__fig {
      position: relative;
    }
  }

  @media (max-width: 767px) {
    /* 880 的 viewBox 縮到手機寬，11px 的標籤會變 4px —— 不硬撐，換檔案樹 */
    .atlas__graph {
      display: none;
    }
  }

  .atlas__cap {
    margin-top: var(--s4);
    color: var(--paper-78);
    max-width: 58ch;
  }

  .atlas__cap strong {
    color: var(--paper);
    font-weight: inherit;
  }

  /* --- 五篇筆記卡 ----------------------------------------------------------- */

  .deck {
    padding-block: var(--s5) var(--s6);
    border-top: 1px solid var(--paper-18);
  }

  .cards {
    display: grid;
    gap: var(--s4);
    margin-top: var(--s5);
  }

  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* 2-2-1 的節奏：最後一張橫躺，正好是「每日交接」收整段 */
    .card:last-child {
      grid-column: 1 / -1;
    }
    .card:last-child .card__d {
      max-width: 62ch;
    }
  }

  .card {
    border: 1px solid var(--paper-18);
    padding: var(--s4);
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    /* 錨點跳過來時，標題不要貼著固定導覽列 */
    scroll-margin-top: 110px;
  }

  .card__fm {
    color: var(--paper-58);
    line-height: 1.7;
    /* 全域 .mono 會轉大寫 —— 但 frontmatter 是 YAML，真的 vault 裡就是小寫。
       這種小地方決定它讀起來像「真的筆記」還是「畫出來的筆記」。 */
    text-transform: none;
  }

  .card__t {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s3);
  }

  .card__latin {
    color: var(--paper-58);
  }

  .card__d {
    color: var(--paper-78);
    max-width: 46ch;
  }

  .card__links {
    margin-top: auto;
    padding-top: var(--s2);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s2) var(--s3);
    color: var(--paper-58);
  }

  .card__lk {
    color: var(--paper-58);
  }

  /* [[雙括號連結]]：括號淡、字亮，hover 走全站的紅底線語言 */
  .card__wiki {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--paper-78);
    transition: color var(--t-base) var(--ease-out);
  }

  .card__br {
    color: var(--paper-58);
    transition: color var(--t-base) var(--ease-out);
  }

  .card__wiki::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-base) var(--ease-out);
  }

  .card__wiki:hover,
  .card__wiki:focus-visible {
    color: var(--paper);
  }

  .card__wiki:hover .card__br,
  .card__wiki:focus-visible .card__br {
    color: var(--red);
  }

  .card__wiki:hover::after,
  .card__wiki:focus-visible::after {
    transform: scaleX(1);
  }

  /* --- 收尾 ---------------------------------------------------------------- */

  .tail {
    padding-block: var(--s5) var(--s7);
    border-top: 1px solid var(--paper-18);
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    color: var(--paper-78);
  }

  .tail__p {
    max-width: 56ch;
  }

  .tail__mail {
    margin-left: var(--s4);
  }
</style>
