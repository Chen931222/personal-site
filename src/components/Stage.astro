---
/**
 * 首頁舞台 —— 開場交棒之後的主畫面。
 *
 * 三欄：巨型作品名 ／ 影格 ／ 內容簡介。
 *
 * 影格裡放的是**操作網站的錄影**，不是靜態截圖。站主的每個專案都是滾動敘事，
 * 靜態圖等於把作品最有說服力的部分拿掉。
 *
 * **巨型名字不與影格重疊。** 參考站讓字被切斷是成立的，因為他只有一個剛好長到
 * 要被切的名字；這裡有十一筆長短不一的作品，同一個裝置只會變成缺角。
 * 字級上限由「最長的一筆要放得進名字欄」反推，不是憑感覺選的。
 *
 * 四周的 mono 讀數（分類、片名、編號、時間碼）是放映機的儀表，
 * 不是裝飾：它們永遠要跟畫面上那一格是同一件事。
 *
 * 互動規格沿用站主自己的「電影式步進展示 v2」：
 * 滾一下換一幕、900ms 冷卻、deltaY ≥ 20。另加上下鍵、觸控滑動、上下偷看格、分類篩選。
 */
import { CATS } from '../data/projects';
// WORKS = PROJECTS ＋ build 時掃到的影片／首格／縮圖。
// 檔名對了就會出現在站上，不用改資料檔（規則見 src/data/media.ts）。
import { WORKS as PROJECTS } from '../data/media';
import Placeholder from './Placeholder.astro';

// 分母是全部 11 件，跟 /work/list 一致。
// 輪播與列表是同一批作品的兩種看法，不是兩份不同的清單。
const total = String(PROJECTS.length).padStart(2, '0');
---

<section class="stage" data-stage aria-roledescription="作品輪播" aria-label="全部作品">
  <!--
    滿版背景層。

    參考站的整個視窗就是作品的影像，中央那個影格是另一個窗口 ——
    兩層在換幕時**一起**開合。原本這裡只做了中央那一層，背景是死的深色，
    所以換幕只有中間在動，讀起來像投影片，不像放映機在換片。

    整層 aria-hidden：它是氛圍，不是內容。同一支影片的資訊已經由中央影格、
    名字欄與簡介欄交代過，讓螢幕閱讀器再念一次只是噪音。
  -->
  <div class="bg" aria-hidden="true">
    {
      PROJECTS.map((p, i) => (
        <div class="bg__i" data-bg data-i={i}>
          {p.video ? (
            <video
              class="bg__v"
              src={p.video}
              poster={p.still ?? undefined}
              muted
              loop
              playsinline
              preload="none"
              data-bg-video
            />
          ) : p.still ? (
            <img class="bg__img" src={p.still} alt="" loading="lazy" decoding="async" />
          ) : null}
        </div>
      ))
    }
    <!-- 功能性暗場（DESIGN.md 唯一允許的漸層）。沒有它，巨型名字會壓在
         Mi Español 那種米白畫面上 —— paper 色的字疊在米白上等於隱形。 -->
    <div class="bg__scrim"></div>
  </div>

  <!-- 上下偷看格：被視窗邊緣切掉的前一個／下一個 -->
  <button class="peek peek--up" data-peek="-1" type="button" aria-label="上一個作品">
    <span class="peek__box">
      {
        PROJECTS.map((p, i) => (
          <span class="peek__i" data-peek-slot={i} aria-hidden="true">
            <Placeholder src={p.cover} ratio="16 / 9" label={p.latin} />
          </span>
        ))
      }
    </span>
  </button>

  <div class="deck">
    <!-- ① 左：巨型作品名 -->
    <div class="nm" aria-hidden="true">
      {
        PROJECTS.map((p, i) => (
          <span class="nm__i" data-nm data-i={i}>
            <span class="ovh">
              <span class="nm__t" data-nm-line>
                {p.short}
              </span>
            </span>
          </span>
        ))
      }
    </div>

    <!-- ② 影格 -->
    <div class="gate">
      <p class="gate__rail mono">
        <span class="gate__rail-l" data-cat>建檔</span>
        <span class="gate__marks" aria-hidden="true">
          <span class="gate__mark">v</span>
          <span class="gate__mark">14</span>
          <span class="gate__mark">v</span>
        </span>
        <span class="gate__rail-r" data-kind>實體藏書</span>
      </p>

      <!-- 這一層在桌面是 display:contents（等於不存在）。
           窄螢幕時它變成 container-type:size 的量測容器 ——
           影格要「用剩下的空間」，而剩下多少只有量得到，推算不出來。 -->
      <div class="gate__box">
        <div class="gate__frame" data-frame>
          <span class="br br--tl" aria-hidden="true"></span>
          <span class="br br--tr" aria-hidden="true"></span>
          <span class="br br--bl" aria-hidden="true"></span>
          <span class="br br--br" aria-hidden="true"></span>

          <div class="gate__media">
            {
              PROJECTS.map((p, i) => (
                <div
                  class="shot"
                  data-slide
                  data-i={i}
                  data-m-cat={p.cat}
                  data-m-kind={p.kind}
                  data-m-title={p.latin}
                  data-m-live={p.href ? '1' : '0'}
                >
                  {p.video ? (
                    <video
                      class="shot__v"
                      src={p.video}
                      poster={p.still ?? undefined}
                      muted
                      loop
                      playsinline
                      preload={i === 0 ? 'auto' : 'none'}
                      data-shot-video
                    />
                  ) : (
                    <Placeholder
                      src={p.still}
                      ratio="16 / 9"
                      label={`${p.latin} · 操作錄影`}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      class="shot__img"
                    />
                  )}
                </div>
              ))
            }
          </div>

          <!-- 整格就是進站的按鈕。桌面另有跟著游標跑的標籤；右欄也有明確的按鈕。 -->
          {
            PROJECTS.map((p, i) => (
              <a
                class="gate__hit"
                data-hit
                data-i={i}
                href={p.href ?? undefined}
                target={p.href ? '_blank' : undefined}
                rel={p.href ? 'noopener noreferrer' : undefined}
                aria-label={p.href ? `進入 ${p.name}（另開視窗）` : `${p.name}：尚未上線`}
              />
            ))
          }
        </div>
      </div>

      <p class="gate__foot mono">
        <span class="gate__foot-l"><span data-counter>01</span>.</span>
        {/* 首格標題：JS 接手後會改寫，但寫死的初值會在作品增刪後變成鬼影
            （原本寫死的那個字，指向的作品後來被撤下了）—— 取第一件才永遠對得上。
            另外：這裡要用大括號註解，HTML 註解會被原封不動印進頁面。 */}
        <span class="gate__foot-c" data-title>{PROJECTS[0].latin}</span>
        <span class="gate__foot-r">.{total}</span>
      </p>
    </div>

    <!-- ③ 右：內容簡介 -->
    <div class="info">
      {
        PROJECTS.map((p, i) => (
          <div class="info__i" data-info data-i={i}>
            <p class="mono info__no">
              [ {String(i + 1).padStart(2, '0')} · {p.year} ]
            </p>
            <p class="info__d">{p.desc}</p>
            <p class="mono info__m">
              <span class:list={['dot', { 'dot--live': p.status === 'live' }]} aria-hidden="true" />
              {p.status === 'live' ? '上線中' : p.status === 'private' ? '不公開' : '進行中'}
              <span class="info__sep" aria-hidden="true">·</span>
              {p.tags.join(' / ')}
            </p>
            {p.href ? (
              <a class="btn info__go" href={p.href} target="_blank" rel="noopener noreferrer">
                進站 <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="btn btn--off info__go">尚未上線</span>
            )}
          </div>
        ))
      }
    </div>
  </div>

  <button class="peek peek--dn" data-peek="1" type="button" aria-label="下一個作品">
    <span class="peek__box">
      {
        PROJECTS.map((p, i) => (
          <span class="peek__i" data-peek-slot={i} aria-hidden="true">
            <Placeholder src={p.cover} ratio="16 / 9" label={p.latin} />
          </span>
        ))
      }
    </span>
  </button>

  <!-- 跟著游標跑的標籤。桌面限定 —— 觸控裝置沒有游標可跟。 -->
  <div class="cur" data-cursor aria-hidden="true">
    <span class="dot dot--live"></span>
    <span data-cursor-t>進站</span>
  </div>

  <!-- 底部儀表列 -->
  <div class="bar">
    <p class="mono bar__c">© 2026</p>

    <p class="mono bar__c bar__view">
      <span class="is-on">輪播</span>
      <span aria-hidden="true">/</span>
      <a class="lnk" href="/work/list">列表</a>
    </p>

    <div class="bar__filters">
      <button class="mono fl is-on" data-filter="" type="button">
        全部 <span class="fl__n">({PROJECTS.length})</span>
      </button>
      {
        CATS.map((f) => (
          <button class="mono fl" data-filter={f.cat} type="button">
            {f.cat} <span class="fl__n">({f.n})</span>
          </button>
        ))
      }
    </div>

    <p class="mono bar__c bar__tc" data-timecode aria-hidden="true">00:00:00</p>

    <p class="mono bar__c bar__end">
      <a class="lnk" href="/#about">關於</a>
    </p>
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-announce></p>
</section>

<style>
  .stage {
    --gate-w: min(36vw, 520px);
    --deck-gap: clamp(20px, 2.8vw, 44px);
    --edge: calc(var(--gutter) + var(--rail));
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: clip;
  }

  /* --- 滿版背景層 --------------------------------------------------------- */

  /**
   * 背景只存在於畫面中央，往邊緣整個衰減掉。
   *
   * 為什麼不是靠加濃暗場：所有的儀表（導覽列、巨型名字、右欄簡介、底部分類）
   * 都住在畫面邊緣。背景鋪滿之後實測的對比是 ——
   *
   *     巨型名字 6.73:1 ✅ ／ 右欄簡介 4.18:1 ⚠️ ／ 底部分類 2.20:1 ❌
   *
   * 分類那排本來在純底上是 3.4:1，鋪了背景直接掉到 2.2。
   * 而 --paper-38 這種半透明文字疊在影像上會**跟著背景一起變亮**，
   * 所以只把字調亮救不回來，得讓字底下真的是純底。
   *
   * 把整層用 radial 遮罩收進中央：邊緣完全沒有背景（儀表回到原本的對比），
   * 中央保留滿版的影像感。這也正好是放映機的樣子 —— 光本來就往邊緣衰減。
   */
  .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(
      ellipse 66% 58% at 50% 46%,
      #000 0%,
      #000 38%,
      transparent 76%
    );
    mask-image: radial-gradient(
      ellipse 66% 58% at 50% 46%,
      #000 0%,
      #000 38%,
      transparent 76%
    );
  }

  .bg__i {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    /* 跟中央影格同一條中線、同一個布幕動作 —— 兩層是一個動作的兩個深度，
       不是兩段各自播完的接力。 */
    clip-path: polygon(50% 0%, 50% 0%, 50% 100%, 50% 100%);
    will-change: opacity, clip-path;
  }

  .bg__v,
  .bg__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /**
   * 暗場的強度是**量出來的，不是調到好看為止**。
   *
   * 最壞的情況是 Mi Español —— 它整片是米白紙感（約 #F5F0E6）。
   * paper 色的巨型名字（#E9E4D8）疊在那上面對比是 1.05:1，等於隱形。
   * 壓到 0.88 之後底色降到約 #241f1c，名字回到 9.4:1（AA 要 4.5）。
   *
   * 中央的影格**不受這層影響**（它在 .deck 裡、疊在暗場之上），
   * 所以「亮的是銀幕、周圍沉下去」這條世界觀反而更成立了。
   */
  .bg__scrim {
    position: absolute;
    inset: 0;
    background: rgba(12, 12, 11, 0.88);
  }

  /* --- 三欄：名字 ／ 影格 ／ 簡介 ---------------------------------------- */

  .deck {
    position: relative;
    z-index: 1;
    display: grid;
    /* 名字欄比簡介欄寬一點 —— 巨型襯線吃寬度，內文吃行數 */
    grid-template-columns: 1.1fr var(--gate-w) 0.9fr;
    gap: var(--deck-gap);
    align-items: center;
    width: 100%;
    padding-inline: var(--edge);
  }

  /* --- ① 名字 ---------------------------------------------------------- */

  .nm {
    display: grid;
    grid-template-areas: 'stack';
    align-items: center;
    justify-items: end;
    text-align: right;
    min-width: 0;
  }

  .nm__i {
    grid-area: stack;
    display: block;
    max-width: 100%;
  }

  .nm__t {
    display: block;
    font-family: var(--font-display);
    font-weight: 200;
    /* 上限由「最長的一筆 short 要放得進名字欄」反推，不是憑感覺選的。
       名字絕不與影格重疊 —— 缺角的巨型字不是戲劇性，是排版錯誤。 */
    font-size: clamp(2.2rem, 4.9vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
    transform: translateY(112%);
    will-change: transform;
  }

  /* --- ② 影格 ---------------------------------------------------------- */

  .gate {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .gate__rail,
  .gate__foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s3);
  }

  .gate__rail-r,
  .gate__foot-r {
    text-align: right;
  }

  .gate__rail-l,
  .gate__rail-r,
  .gate__foot-c {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gate__foot-c {
    color: var(--paper-64);
    letter-spacing: 0.14em;
    text-align: center;
  }

  .gate__marks {
    display: flex;
    gap: 6px;
  }

  .gate__mark {
    width: 17px;
    height: 17px;
    display: grid;
    place-items: center;
    border: 1px solid var(--paper-18);
    border-radius: 50%;
    font-size: 8px;
    line-height: 1;
    color: var(--paper-38);
  }

  /* 桌面：這一層不存在，影格直接是 .gate 的 flex 子元素 */
  .gate__box {
    display: contents;
  }

  .gate__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ink-lift);
  }

  /* 片門角標 */
  .br {
    position: absolute;
    width: 15px;
    height: 15px;
    z-index: 3;
    pointer-events: none;
    border: 0 solid var(--paper-64);
  }
  .br--tl { top: -1px; left: -1px; border-top-width: 1px; border-left-width: 1px; }
  .br--tr { top: -1px; right: -1px; border-top-width: 1px; border-right-width: 1px; }
  .br--bl { bottom: -1px; left: -1px; border-bottom-width: 1px; border-left-width: 1px; }
  .br--br { bottom: -1px; right: -1px; border-bottom-width: 1px; border-right-width: 1px; }

  .gate__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .shot {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    clip-path: polygon(50% 0%, 50% 0%, 50% 100%, 50% 100%);
    will-change: opacity, clip-path;
  }

  .shot__v,
  .shot :global(.ph),
  .shot :global(.ph-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto !important;
  }

  .shot :global(.ph) {
    border: 0;
  }

  .gate__hit {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: none;
  }

  .gate__hit[data-active] {
    display: block;
  }

  /* --- ③ 簡介 ---------------------------------------------------------- */

  .info {
    display: grid;
    grid-template-areas: 'stack';
    align-items: center;
    min-width: 0;
  }

  .info__i {
    grid-area: stack;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s3);
    opacity: 0;
    visibility: hidden;
    will-change: opacity, transform;
  }

  .info__d {
    font-size: clamp(0.95rem, 1.05vw, 1.05rem);
    line-height: 1.72;
    color: var(--paper-64);
    max-width: 34ch;
  }

  .info__m {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  .info__sep {
    color: var(--paper-18);
  }

  .info__go {
    margin-top: var(--s1);
  }

  .btn--off {
    color: var(--paper-38);
    cursor: default;
  }

  /* --- 上下偷看格 --------------------------------------------------------- */

  .peek {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    width: min(18vw, 260px);
    z-index: 1;
    padding: 0;
    opacity: 0.45;
    transition: opacity var(--t-base) var(--ease-out);
  }

  .peek:hover,
  .peek:focus-visible {
    opacity: 1;
  }

  .peek--up {
    top: 0;
    translate: -50% -60%;
  }

  .peek--dn {
    bottom: 0;
    translate: -50% 60%;
  }

  .peek__box {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
  }

  .peek__i {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }

  .peek__i[data-active] {
    opacity: 1;
    visibility: visible;
  }

  .peek__i :global(.ph),
  .peek__i :global(.ph-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto !important;
  }

  /* --- 跟著游標跑的標籤 ----------------------------------------------------- */

  .cur {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 500;
    display: none;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
    background: rgba(12, 12, 11, 0.72);
    border: 1px solid var(--paper-18);
    pointer-events: none;
    opacity: 0;
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 900px) {
    .cur {
      display: flex;
    }
  }

  /* --- 底部儀表列 ------------------------------------------------------- */

  /* 不放進度刻度：一排小橫條讀起來像進度條，是後台的語彙，不是放映室的。
     位置由影格下方的 01. / .11 交代就夠了。 */
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--s4);
    z-index: 3;
    display: flex;
    align-items: flex-end;
    /* 不用 space-between 平均分散 —— 左邊是「這是什麼」（版權、檢視方式），
       右邊是「機器的讀數」（分類、時間碼、出口），中間那段空白就是分組的方式。 */
    justify-content: flex-start;
    gap: clamp(20px, 4vw, 64px);
    padding-inline: var(--edge);
  }

  .bar__view {
    margin-left: clamp(16px, 5vw, 110px);
  }

  .bar__c {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
  }

  /* min-height 要下在 <a> 本身，不是外層的 <p> —— 觸控目標量的是連結的框
     （WCAG 2.2 SC 2.5.8，24×24） */
  .bar a {
    display: inline-flex;
    align-items: center;
    /* 26 而不是剛好 24：次像素捨入會讓 24 量出來變 23.99，卡在門檻上。
       橫向也補一點 —— 「列表」兩個中文字只有 23px 寬。 */
    min-height: 26px;
    padding-inline: 3px;
  }

  .bar__view .is-on {
    color: var(--paper);
  }

  .bar__tc {
    font-variant-numeric: tabular-nums;
    color: var(--paper-38);
  }

