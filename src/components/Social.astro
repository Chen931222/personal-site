---
/**
 * 社群連結：圖示 ＋ 文字標籤。
 *
 * 三個地方共用（關於我結尾、全螢幕選單頁腳、全站頁尾）—— 一份實作，
 * 免得改一次要改三處，然後漏掉一處。
 *
 * ── 顏色 ──────────────────────────────────────────────────────────
 *
 * 站主指定「先用品牌色」。要注意兩件事：
 *
 * ① **GitHub 的品牌色在這裡是白色，不是黑色。** 官方標準色 #181717 貼在 #0C0C0B 的底上
 *    等於隱形；GitHub 自己的規範也是深底用白貓。所以「用他們的顏色」在深色站上
 *    對 GitHub 而言就是白。
 *
 * ② **只有圖示上色，文字標籤維持 paper 色。** LinkedIn 藍 #0A66C2 對 #0C0C0B 的
 *    對比是 3.45:1 —— 當圖形（WCAG 1.4.11 要 3:1）過關，當文字（要 4.5:1）不過關。
 *    藍色的 GITHUB／LINKEDIN 字會直接踩無障礙紅線。
 *
 * 想改回單色（DESIGN.md 的原則：全站只有一個強調色）就把 BRAND 改成 false，
 * 圖示會跟著文字一起用 currentColor。
 */
interface Props {
  label: string;
  href: string;
  /** 圖示用品牌色；false = 跟著文字走 currentColor */
  brand?: boolean;
  class?: string;
}
const { label, href, brand = true, class: cls } = Astro.props;

const KEY = label.toUpperCase();

/** 官方 mark 的路徑。24×24 viewBox，單一 path，不夾雜多餘的圖層。 */
const PATHS: Record<string, string> = {
  GITHUB:
    'M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.24-.02-2.25-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.8 5.65-5.48 5.95.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.3 0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z',
  LINKEDIN:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z',
};

/** 深底上的品牌色。GitHub 深底用白 —— #181717 貼在 #0C0C0B 上是隱形的。 */
const BRAND_COLOR: Record<string, string> = {
  GITHUB: '#FFFFFF',
  LINKEDIN: '#0A66C2',
};

const d = PATHS[KEY];
const color = brand && BRAND_COLOR[KEY] ? BRAND_COLOR[KEY] : 'currentColor';
---

<a
  class:list={['soc', cls]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  {
    d && (
      <svg class="soc__i" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style={`--c:${color}`}>
        <path d={d} />
      </svg>
    )
  }
  <span class="mono soc__t">{label}</span>
  <span class="soc__go" aria-hidden="true">↗</span>
</a>

<style>
  .soc {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    /* 觸控目標：26 而不是剛好 24 —— 次像素捨入會讓 24 量出來變 23.99 */
    min-height: 26px;
    color: var(--paper-78);
    transition: color var(--t-base) var(--ease-out);
  }

  .soc:hover,
  .soc:focus-visible {
    color: var(--paper);
  }

  .soc__i {
    width: 15px;
    height: 15px;
    flex: none;
    fill: var(--c);
    /* 圖示比文字略降一點透明度，滑過去才亮起來 ——
       品牌色在這個世界裡是客人，不該比站主自己的紅色還搶眼。 */
    opacity: 0.82;
    transition: opacity var(--t-base) var(--ease-out);
  }

  .soc:hover .soc__i,
  .soc:focus-visible .soc__i {
    opacity: 1;
  }

  /* 文字一律跟著站的顏色走，不上品牌色 —— 見檔頭的對比說明。
     `color: inherit` 是必要的：全域的 .mono 把顏色鎖在 metadata 那級（--paper-58，約 5.6:1）。
     這兩個連結是「讓別人找到我」用的，不該跟讀數同一級、是全站最暗的字。
     繼承 .soc 的 --paper-78 之後約 9.5:1。（2026-09-30 前 .mono 是 --paper-38，只有 3.02:1。） */
  .soc__t {
    color: inherit;
    letter-spacing: 0.08em;
  }

  .soc__go {
    font-size: 0.9em;
    opacity: 0.7;
  }
</style>
