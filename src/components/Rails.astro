---
/**
 * 邊緣呎數標尺 —— 底片邊上的 footage counter。
 *
 * 兩個關鍵決定：
 *
 * ① **由使用者的滾動驅動，不自己跑。**
 *    自動、持續、超過五秒的動態內容會落入 WCAG 2.2 SC 2.2.2（暫停／停止／隱藏）的範圍，
 *    要另外給控制項才合規。改成滾輪／觸控的慣性驅動之後，動作是使用者發起的，
 *    不在該條規範範圍內 —— 而且更像真的呎數表：你捲多少，它就走多少。
 *
 * ② **writing-mode 放在「字條」上，不是放在會捲動的 track 上。**
 *    放在 track 會把 flex 主軸轉向，導致左右兩條的捲動方向相反，得再補 rotateY(180deg) 去救。
 *    放在字條上兩邊就完全一樣，translateY(-50%) 也乾淨地對到一份字條的高度。
 *
 * `sideways-lr` 直到 Safari/iOS 18.4 才支援，所以 @supports 後備是必要的，
 * 不是保險 —— 舊 Safari 會把它當無效宣告，退回 horizontal-tb，
 * 變成一串橫排數字擠在 14px 寬的柱子裡，那不是優雅降級，是壞掉。
 *
 * ③ **刻度數字放在 data-run，由 ::before 印出來，不是頁面文字**（2026-09-30 改）。
 *    它是片邊的花紋，不是內容。放成文字有三個副作用：
 *    不跑 JS 的爬蟲最前面先讀到 200 個四位數刻度，才輪到名字（2026-09-28 實測）；
 *    axe 把它當內文量對比（18% 紙色 1.54:1，而 WCAG 1.4.3 對純裝飾本來就不要求）；
 *    impeccable 把 388 字元的字條當內文，報 wide-tracking。
 *    畫面上一模一樣：writing-mode、white-space、字距都會繼承到 ::before。
 */

// 一份字條約 2–4 倍視窗高就夠了。參考站做到 31,973px、6,450 個字，是浪費。
const seq = (from: number, to: number, step: number) => {
  let out = '';
  for (let i = from; i <= to; i += step) out += '    ' + String(i).padStart(4, '0');
  return out;
};
const RUN = seq(0, 480, 10);
---

<div class="rails" aria-hidden="true" transition:persist>
  <div class="rail rail--l" data-rail>
    <div class="rail__track" data-rail-track>
      <div class="rail__strip" data-run={RUN}></div>
      <div class="rail__strip" data-run={RUN}></div>
    </div>
  </div>
  <div class="rail rail--r" data-rail>
    <div class="rail__track" data-rail-track>
      <div class="rail__strip" data-run={RUN}></div>
      <div class="rail__strip" data-run={RUN}></div>
    </div>
  </div>
</div>

<style>
  .rails {
    position: fixed;
    inset: 0;
    /* 高於全螢幕選單（850），低於導覽列（900）。
       選單打開時呎數表要繼續留在畫面邊緣 —— 放映機沒有停。 */
    z-index: 880;
    display: none;
    justify-content: space-between;
    padding: 0 16px;
    overflow: clip;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /* 手機沒有這個餘裕 —— 邊距要留給內容 */
  @media (min-width: 1024px) {
    .rails {
      display: flex;
    }
  }

  .rail {
    position: relative;
    width: 14px;
    height: 100%;
    overflow: clip;
  }

  /* GSAP 擁有 .rail（開場的掃出），rAF 慣性迴圈擁有 .rail__track。
     兩個系統寫兩個元素，不會互相踩。 */
  .rail__track {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    will-change: transform;
  }

  .rail__strip {
    writing-mode: sideways-lr; /* 字立著，由下往上讀 */
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 14px;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    white-space: pre;
    color: var(--paper-18);
  }

  .rail__strip::before {
    content: attr(data-run);
  }

  .rail--r .rail__strip {
    writing-mode: vertical-rl;
  }

  /* 必要，不是保險：Safari < 18.4 不認 sideways-lr */
  @supports not (writing-mode: sideways-lr) {
    .rail__strip {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }
    .rail--r .rail__strip {
      transform: none;
    }
  }
</style>
