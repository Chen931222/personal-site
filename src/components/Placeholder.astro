---
/**
 * 打樣佔位框 —— 素材未到位時的正式呈現。
 *
 * 不是灰方塊、不是 Unsplash 隨機圖、不是漸層。
 * 是一個 1px 規線的空框，帶對角十字與角落標註，看起來像印刷打樣。
 * 一旦 src 有值就直接渲染真圖，佔位框自動消失。
 */
interface Props {
  /** 有值就渲染圖片；null 顯示佔位框 */
  src?: string | null;
  alt?: string;
  /** 顯示比例，例如 '3 / 2'、'16 / 9' */
  ratio?: string;
  /** 佔位框左下角的用途標註 */
  label?: string;
  /** 圖片載入策略 */
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src = null,
  alt = '',
  ratio = '3 / 2',
  label = '待補',
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const ratioTag = ratio.replace(/\s*\/\s*/, ':');
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      loading={loading}
      decoding="async"
      class={`ph-img ${className}`}
      style={`aspect-ratio: ${ratio};`}
    />
  ) : (
    <div
      class={`ph ${className}`}
      style={`aspect-ratio: ${ratio};`}
      role="img"
      aria-label={`${label}（素材待補）`}
    >
      <span class="ph__ratio" aria-hidden="true">
        {ratioTag}
      </span>
      <span class="ph__tag" aria-hidden="true">
        {label}
      </span>
    </div>
  )
}

<style>
  .ph-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--ink-lift);
  }
</style>
